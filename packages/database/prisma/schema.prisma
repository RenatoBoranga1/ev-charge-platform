generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DRIVER
  OPERATOR
  ADMIN
}

enum VehicleType {
  BEV
  PHEV
  HEV
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  SOLD
}

enum ProfileTheme {
  SYSTEM
  LIGHT
  DARK
}

enum StationStatus {
  AVAILABLE
  PARTIAL
  OCCUPIED
  RESERVED
  OFFLINE
  MAINTENANCE
}

enum ConnectorStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OFFLINE
  MAINTENANCE
}

enum PlugType {
  CCS2
  TYPE_2
  CHADEMO
  NACS
  GB_T
}

enum CurrentType {
  AC
  DC
}

enum ReservationStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ChargingSessionStatus {
  PENDING
  AUTHORIZED
  STARTING
  CHARGING
  STOPPING
  COMPLETED
  FAILED
  CANCELLED
}

enum LedgerAccountOwnerType {
  USER
  PLATFORM
  OPERATOR
}

enum LedgerAccountType {
  USER_WALLET_AVAILABLE
  USER_WALLET_RESERVED
  PAYMENT_GATEWAY_CLEARING
  OPERATOR_REVENUE
  REFUND_CLEARING
  PAYMENT_FEES
  RECONCILIATION_CLEARING
}

enum LedgerAccountStatus {
  ACTIVE
  BLOCKED
  CLOSED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerTransactionType {
  TOP_UP
  AUTHORIZATION
  CAPTURE
  RELEASE
  REFUND
  ADJUSTMENT
  AUTO_RECHARGE
  REVERSAL
}

enum LedgerTransactionStatus {
  PENDING
  POSTED
  REVERSED
  FAILED
}

enum WalletStatus {
  ACTIVE
  BLOCKED
  CLOSED
}

enum WalletReservationStatus {
  RESERVED
  CAPTURED
  RELEASED
  FAILED
}

enum PaymentIntentType {
  WALLET_TOP_UP
  CHARGING_AUTHORIZATION
  CHARGING_CAPTURE
  AUTO_RECHARGE
  REFUND
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  PROCESSING
  CAPTURED
  CANCELLED
  EXPIRED
  FAILED
  REQUIRES_REVIEW
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethodType {
  CARD
  PIX
  WALLET
}

enum PaymentMethodStatus {
  ACTIVE
  EXPIRED
  BLOCKED
  REMOVED
}

enum ReceiptStatus {
  ISSUED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REQUIRES_REVIEW
}

enum PaymentWebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  DUPLICATE
  FAILED
  REQUIRES_REVIEW
}

enum PaymentReconciliationStatus {
  MATCHED
  MISSING_LOCALLY
  MISSING_AT_PROVIDER
  AMOUNT_MISMATCH
  STATUS_MISMATCH
  REQUIRES_REVIEW
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum ChargerProtocol {
  SIMULATOR
  OCPP16
}

enum ChargePointConnectionStatus {
  DISCONNECTED
  CONNECTED
}

enum OcppTransactionStatus {
  REMOTE_START_PENDING
  ACTIVE
  STOPPING
  COMPLETED
  FAILED
}

enum OcppMessageDirection {
  CHARGE_POINT_TO_CSMS
  CSMS_TO_CHARGE_POINT
}

enum OperatorMembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum OperatorRole {
  TENANT_ADMIN
  OPERATIONS_MANAGER
  STATION_OPERATOR
  FINANCE_ANALYST
  SUPPORT_AGENT
  VIEWER
}

enum TariffPublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RemoteCommandType {
  REMOTE_START
  REMOTE_STOP
  RESET
  UNLOCK_CONNECTOR
  CHANGE_AVAILABILITY
  GET_CONFIGURATION
}

enum RemoteCommandStatus {
  CREATED
  QUEUED
  SENT
  ACCEPTED
  REJECTED
  TIMED_OUT
  FAILED
  CANCELLED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

model Tenant {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String                  @unique
  users                  User[]
  operators              Operator[]
  stations               Station[]
  auditLogs              AuditLog[]
  outboxEvents           OutboxEvent[]
  ledgerAccounts         LedgerAccount[]
  ledgerTransactions     LedgerTransaction[]
  wallets                Wallet[]
  paymentIntents         PaymentIntent[]
  paymentMethods         PaymentMethod[]
  paymentPolicyConfigs   PaymentPolicyConfig[]
  receipts               Receipt[]
  autoRechargeRules      AutoRechargeRule[]
  paymentReconciliations PaymentReconciliation[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  deletedAt              DateTime?               @map("deleted_at")
  operatorMemberships    OperatorMembership[]
  tariffVersions         TariffVersion[]
  remoteCommands         RemoteCommand[]

  version                Int                     @default(1)

  @@index([deletedAt])
  @@map("tenants")
}

model User {
  id                         String             @id @default(uuid()) @db.Uuid
  tenantId                   String             @map("tenant_id") @db.Uuid
  tenant                     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email                      String
  passwordHash               String             @map("password_hash")
  role                       UserRole           @default(DRIVER)
  name                       String
  firstName                  String?            @map("first_name")
  lastName                   String?            @map("last_name")
  phone                      String?
  avatarUrl                  String?            @map("avatar_url")
  city                       String?
  state                      String?
  country                    String             @default("BR")
  language                   String             @default("pt-BR")
  theme                      ProfileTheme       @default(SYSTEM)
  preferences                Json?
  notificationPreferences    Json?              @map("notification_preferences")
  privacyPreferences         Json?              @map("privacy_preferences")
  accountDeletionRequestedAt DateTime?          @map("account_deletion_requested_at")
  totalEnergyKwh             Decimal            @default(0) @map("total_energy_kwh") @db.Decimal(12, 3)
  avoidedCo2Kg               Decimal            @default(0) @map("avoided_co2_kg") @db.Decimal(12, 3)
  estimatedSavings           Decimal            @default(0) @map("estimated_savings") @db.Decimal(12, 2)
  refreshTokens              RefreshToken[]
  vehicles                   Vehicle[]
  reservations               Reservation[]
  chargingSessions           ChargingSession[]
  wallets                    Wallet[]
  paymentIntents             PaymentIntent[]
  paymentMethods             PaymentMethod[]
  receipts                   Receipt[]
  autoRechargeRules          AutoRechargeRule[]
  auditLogs                  AuditLog[]
  createdAt                  DateTime           @default(now()) @map("created_at")
  operatorMemberships       OperatorMembership[]
  remoteCommandsCreated     RemoteCommand[]       @relation("RemoteCommandCreator")
  isBlocked                 Boolean               @default(false) @map("is_blocked")
  blockedAt                 DateTime?             @map("blocked_at")
  blockedReason             String?               @map("blocked_reason")

  updatedAt                  DateTime           @updatedAt @map("updated_at")
  deletedAt                  DateTime?          @map("deleted_at")
  version                    Int                @default(1)

  @@unique([tenantId, email])
  @@index([tenantId, deletedAt])
  @@map("users")
}

model RefreshToken {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String        @unique @map("token_hash")
  familyId          String        @map("family_id") @db.Uuid
  expiresAt         DateTime      @map("expires_at")
  revokedAt         DateTime?     @map("revoked_at")
  replacedByTokenId String?       @unique @map("replaced_by_token_id") @db.Uuid
  replacedBy        RefreshToken? @relation("RefreshRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces          RefreshToken? @relation("RefreshRotation")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([userId, familyId])
  @@index([expiresAt, revokedAt])
  @@map("refresh_tokens")
}

model Vehicle {
  id                            String            @id @default(uuid()) @db.Uuid
  userId                        String            @map("user_id") @db.Uuid
  user                          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand                         String
  model                         String
  nickname                      String            @default("Meu veículo")
  trim                          String?
  year                          Int?
  color                         String?
  licensePlate                  String?           @map("license_plate")
  vin                           String?
  vehicleType                   VehicleType       @map("vehicle_type")
  batteryCapacityKwh            Decimal           @map("battery_capacity_kwh") @db.Decimal(8, 2)
  estimatedRangeKm              Int?              @map("estimated_range_km")
  averageConsumptionKwhPer100Km Decimal?          @map("average_consumption_kwh_per_100_km") @db.Decimal(8, 2)
  maximumAcPowerKw              Decimal?          @map("maximum_ac_power_kw") @db.Decimal(8, 2)
  maximumDcPowerKw              Decimal?          @map("maximum_dc_power_kw") @db.Decimal(8, 2)
  supportedPlugTypes            PlugType[]        @map("supported_plug_types")
  status                        VehicleStatus     @default(ACTIVE)
  imageUrl                      String?           @map("image_url")
  notes                         String?
  isDefault                     Boolean           @default(false) @map("is_default")
  chargingSessions              ChargingSession[]
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")
  deletedAt                     DateTime?         @map("deleted_at")
  version                       Int               @default(1)

  @@index([userId, deletedAt])
  @@index([userId, isDefault])
  @@map("vehicles")
}

model Operator {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  code      String
  stations  Station[]
  tariffs   Tariff[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@map("operators")
}

model Station {
  id               String                                 @id @default(uuid()) @db.Uuid
  tenantId         String                                 @map("tenant_id") @db.Uuid
  tenant           Tenant                                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  operatorId       String                                 @map("operator_id") @db.Uuid
  operator         Operator                               @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  name             String
  address          String
  city             String
  state            String
  country          String                                 @default("BR")
  postalCode       String?                                @map("postal_code")
  latitude         Decimal                                @db.Decimal(10, 7)
  longitude        Decimal                                @db.Decimal(10, 7)
  location         Unsupported("geography(Point, 4326)")?
  status           StationStatus                          @default(AVAILABLE)
  openingHours     String                                 @default("Aberta 24 horas") @map("opening_hours")
  isOpen24Hours    Boolean                                @default(true) @map("is_open_24_hours")
  hasParking       Boolean                                @default(false) @map("has_parking")
  rating           Decimal                                @default(0) @db.Decimal(3, 2)
  chargePoints     ChargePoint[]
  tariffs          Tariff[]
  reservations     Reservation[]
  chargingSessions ChargingSession[]
  remoteCommands   RemoteCommand[]
  createdAt        DateTime                               @default(now()) @map("created_at")
  updatedAt        DateTime                               @updatedAt @map("updated_at")
  deletedAt        DateTime?                              @map("deleted_at")
  version          Int                                    @default(1)

  @@index([tenantId, status, deletedAt])
  @@index([operatorId])
  @@map("stations")
}

model ChargePoint {
  id                 String                      @id @default(uuid()) @db.Uuid
  stationId          String                      @map("station_id") @db.Uuid
  station            Station                     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  externalCode       String                      @map("external_code")
  name               String?
  status             StationStatus               @default(AVAILABLE)
  protocol           ChargerProtocol             @default(SIMULATOR)
  ocppIdentity       String?                     @unique @map("ocpp_identity")
  ocppEnabled        Boolean                     @default(false) @map("ocpp_enabled")
  ocppAuthSecretHash String?                     @map("ocpp_auth_secret_hash")
  connectionStatus   ChargePointConnectionStatus @default(DISCONNECTED) @map("connection_status")
  lastSeenAt         DateTime?                   @map("last_seen_at")
  evses              Evse[]
  chargingSessions   ChargingSession[]
  ocppTransactions   OcppTransaction[]
  ocppMessages       OcppMessage[]
  remoteCommands     RemoteCommand[]
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  deletedAt          DateTime?                   @map("deleted_at")
  version            Int                         @default(1)

  @@unique([stationId, externalCode])
  @@index([stationId, deletedAt])
  @@map("charge_points")
}

model Evse {
  id               String            @id @default(uuid()) @db.Uuid
  chargePointId    String            @map("charge_point_id") @db.Uuid
  chargePoint      ChargePoint       @relation(fields: [chargePointId], references: [id], onDelete: Cascade)
  uid              String
  status           ConnectorStatus   @default(AVAILABLE)
  connectors       Connector[]
  chargingSessions ChargingSession[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  version          Int               @default(1)

  @@unique([chargePointId, uid])
  @@index([chargePointId, deletedAt])
  @@map("evses")
}

model Connector {
  id                 String            @id @default(uuid()) @db.Uuid
  evseId             String            @map("evse_id") @db.Uuid
  evse               Evse              @relation(fields: [evseId], references: [id], onDelete: Cascade)
  code               String            @unique
  number             Int
  plugType           PlugType          @map("plug_type")
  currentType        CurrentType       @map("current_type")
  maximumPowerKw     Decimal           @map("maximum_power_kw") @db.Decimal(8, 2)
  status             ConnectorStatus   @default(AVAILABLE)
  externalIdentifier String?           @map("external_identifier")
  reservations       Reservation[]
  chargingSessions   ChargingSession[]
  ocppTransactions   OcppTransaction[]
  remoteCommands     RemoteCommand[]
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  version            Int               @default(1)

  @@unique([evseId, number])
  @@index([evseId, status, deletedAt])
  @@map("connectors")
}

model Tariff {
  id               String            @id @default(uuid()) @db.Uuid
  stationId        String            @map("station_id") @db.Uuid
  station          Station           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  operatorId       String            @map("operator_id") @db.Uuid
  operator         Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  name             String
  currency         String            @default("BRL")
  pricePerKwh      Decimal           @map("price_per_kwh") @db.Decimal(10, 4)
  activationFee    Decimal           @default(0) @map("activation_fee") @db.Decimal(10, 2)
  parkingFeeHour   Decimal           @default(0) @map("parking_fee_hour") @db.Decimal(10, 2)
  validFrom        DateTime          @default(now()) @map("valid_from")
  validUntil       DateTime?         @map("valid_until")
  chargingSessions ChargingSession[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  publicationStatus TariffPublicationStatus @default(PUBLISHED) @map("publication_status")
  publishedAt       DateTime?               @default(now()) @map("published_at")
  archivedAt        DateTime?               @map("archived_at")
  versions          TariffVersion[]
  version          Int               @default(1)

  @@index([stationId, validFrom, validUntil])
  @@index([operatorId, deletedAt])
  @@map("tariffs")
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  stationId   String            @map("station_id") @db.Uuid
  station     Station           @relation(fields: [stationId], references: [id], onDelete: Restrict)
  connectorId String            @map("connector_id") @db.Uuid
  connector   Connector         @relation(fields: [connectorId], references: [id], onDelete: Restrict)
  startsAt    DateTime          @map("starts_at")
  expiresAt   DateTime          @map("expires_at")
  status      ReservationStatus @default(CONFIRMED)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")
  version     Int               @default(1)

  @@index([userId, status, startsAt])
  @@index([connectorId, startsAt, expiresAt])
  @@map("reservations")
}

model ChargingSession {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @map("user_id") @db.Uuid
  user               User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicleId          String                @map("vehicle_id") @db.Uuid
  vehicle            Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  stationId          String                @map("station_id") @db.Uuid
  station            Station               @relation(fields: [stationId], references: [id], onDelete: Restrict)
  chargePointId      String                @map("charge_point_id") @db.Uuid
  chargePoint        ChargePoint           @relation(fields: [chargePointId], references: [id], onDelete: Restrict)
  evseId             String                @map("evse_id") @db.Uuid
  evse               Evse                  @relation(fields: [evseId], references: [id], onDelete: Restrict)
  connectorId        String                @map("connector_id") @db.Uuid
  connector          Connector             @relation(fields: [connectorId], references: [id], onDelete: Restrict)
  tariffId           String                @map("tariff_id") @db.Uuid
  tariff             Tariff                @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  idempotencyKey     String?               @map("idempotency_key")
  status             ChargingSessionStatus @default(PENDING)
  meterStartWh       BigInt?               @map("meter_start_wh")
  meterStopWh        BigInt?               @map("meter_stop_wh")
  startedAt          DateTime?             @map("started_at")
  stoppedAt          DateTime?             @map("stopped_at")
  completedAt        DateTime?             @map("completed_at")
  failureReason      String?               @map("failure_reason")
  tariffSnapshot     Json                  @map("tariff_snapshot")
  energyKwh          Decimal               @default(0) @map("energy_kwh") @db.Decimal(12, 3)
  currentPowerKw     Decimal               @default(0) @map("current_power_kw") @db.Decimal(8, 2)
  estimatedCost      Decimal               @default(0) @map("estimated_cost") @db.Decimal(12, 2)
  totalAmount        Decimal               @default(0) @map("total_amount") @db.Decimal(12, 2)
  meterValues        MeterValue[]
  ocppTransaction    OcppTransaction?
  paymentIntents     PaymentIntent[]
  walletReservations WalletReservation[]
  receipt            Receipt?
  remoteCommands     RemoteCommand[]
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  deletedAt          DateTime?             @map("deleted_at")
  version            Int                   @default(1)

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([connectorId, status])
  @@index([stationId, status, createdAt])
  @@index([vehicleId, createdAt])
  @@index([userId, startedAt, id])
  @@index([userId, status, startedAt, id])
  @@index([userId, vehicleId, startedAt, id])
  @@index([userId, stationId, startedAt, id])
  @@index([userId, connectorId, startedAt, id])
  @@map("charging_sessions")
}

model OcppTransaction {
  id                     String                @id @default(uuid()) @db.Uuid
  chargePointId          String                @map("charge_point_id") @db.Uuid
  chargePoint            ChargePoint           @relation(fields: [chargePointId], references: [id], onDelete: Restrict)
  connectorId            String                @map("connector_id") @db.Uuid
  connector              Connector             @relation(fields: [connectorId], references: [id], onDelete: Restrict)
  chargingSessionId      String                @unique @map("charging_session_id") @db.Uuid
  chargingSession        ChargingSession       @relation(fields: [chargingSessionId], references: [id], onDelete: Restrict)
  protocolTransactionId  Int                   @unique @default(autoincrement()) @map("protocol_transaction_id")
  authorizationTokenHash String                @map("authorization_token_hash")
  status                 OcppTransactionStatus @default(REMOTE_START_PENDING)
  meterStartWh           BigInt?               @map("meter_start_wh")
  lastMeterWh            BigInt?               @map("last_meter_wh")
  meterStopWh            BigInt?               @map("meter_stop_wh")
  startedAt              DateTime?             @map("started_at")
  stoppedAt              DateTime?             @map("stopped_at")
  failureReason          String?               @map("failure_reason")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  version                Int                   @default(1)

  @@index([chargePointId, status])
  @@index([connectorId, status])
  @@index([authorizationTokenHash, status])
  @@map("ocpp_transactions")
}

model OcppMessage {
  id            String               @id @default(uuid()) @db.Uuid
  chargePointId String               @map("charge_point_id") @db.Uuid
  chargePoint   ChargePoint          @relation(fields: [chargePointId], references: [id], onDelete: Cascade)
  direction     OcppMessageDirection
  uniqueId      String               @map("unique_id")
  action        String
  response      Json?
  correlationId String               @map("correlation_id")
  createdAt     DateTime             @default(now()) @map("created_at")

  @@unique([chargePointId, direction, uniqueId])
  @@index([chargePointId, createdAt])
  @@map("ocpp_messages")
}

model MeterValue {
  id                String          @id @default(uuid()) @db.Uuid
  chargingSessionId String          @map("charging_session_id") @db.Uuid
  chargingSession   ChargingSession @relation(fields: [chargingSessionId], references: [id], onDelete: Cascade)
  sampledAt         DateTime        @map("sampled_at")
  meterWh           BigInt          @map("meter_wh")
  energyKwh         Decimal         @map("energy_kwh") @db.Decimal(12, 3)
  powerKw           Decimal?        @map("power_kw") @db.Decimal(8, 2)
  batteryPercent    Int?            @map("battery_percent")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@unique([chargingSessionId, sampledAt])
  @@index([chargingSessionId, sampledAt])
  @@map("meter_values")
}

model LedgerAccount {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ownerType   LedgerAccountOwnerType @map("owner_type")
  ownerId     String                 @map("owner_id") @db.Uuid
  accountType LedgerAccountType      @map("account_type")
  currency    String                 @default("BRL") @db.Char(3)
  status      LedgerAccountStatus    @default(ACTIVE)
  entries     LedgerEntry[]
  createdAt   DateTime               @default(now()) @map("created_at")

  @@unique([tenantId, ownerType, ownerId, accountType, currency])
  @@index([tenantId, ownerId, status])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type              LedgerTransactionType
  status            LedgerTransactionStatus @default(PENDING)
  idempotencyKey    String                  @map("idempotency_key")
  requestHash       String                  @map("request_hash")
  externalReference String?                 @map("external_reference")
  description       String
  chargingSessionId String?                 @map("charging_session_id") @db.Uuid
  paymentIntentId   String?                 @map("payment_intent_id") @db.Uuid
  metadata          Json?
  entries           LedgerEntry[]
  reversalOfId      String?                 @unique @map("reversal_of_id") @db.Uuid
  reversalOf        LedgerTransaction?      @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy        LedgerTransaction?      @relation("LedgerReversal")
  createdAt         DateTime                @default(now()) @map("created_at")
  postedAt          DateTime?               @map("posted_at")
  reversedAt        DateTime?               @map("reversed_at")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt, id])
  @@index([paymentIntentId])
  @@index([chargingSessionId])
  @@map("ledger_transactions")
}

model LedgerEntry {
