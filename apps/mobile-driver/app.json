{
  "expo": {
    "name": "Solis Plataformas",
    "slug": "solis-plataformas",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "solis",
    "icon": "./assets/brand/solis-app-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/solis-splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#082868"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solis.plataformas",
      "icon": "./assets/brand/solis-app-icon.png"
    },
    "android": {
      "package": "com.solis.plataformas",
      "icon": "./assets/brand/solis-app-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#082868",
        "foregroundImage": "./assets/brand/solis-symbol.png",
        "monochromeImage": "./assets/brand/solis-adaptive-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/solis-symbol.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "A Solis usa a câmera somente para ler o QR Code do carregador."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A Solis usa sua localização para encontrar estações próximas."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
